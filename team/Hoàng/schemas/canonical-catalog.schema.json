{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/a-plus/canonical-catalog.schema.json",
  "title": "A+ Canonical Catalog Records",
  "description": "Draft schema. Category-specific specifications require Product Expert approval.",
  "oneOf": [
    {
      "$ref": "#/$defs/ProductModel"
    },
    {
      "$ref": "#/$defs/ProductVariant"
    },
    {
      "$ref": "#/$defs/Source"
    },
    {
      "$ref": "#/$defs/Evidence"
    },
    {
      "$ref": "#/$defs/Merchant"
    },
    {
      "$ref": "#/$defs/Offer"
    },
    {
      "$ref": "#/$defs/PriceObservation"
    }
  ],
  "$defs": {
    "ProductModel": {
      "type": "object",
      "required": [
        "record_type",
        "id",
        "schema_version",
        "created_at",
        "updated_at",
        "status",
        "category_id",
        "brand",
        "model_name",
        "normalized_model_key",
        "identifiers"
      ],
      "properties": {
        "record_type": {
          "const": "product_model"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "suppressed",
            "archived"
          ]
        },
        "category_id": {
          "type": "string",
          "minLength": 1
        },
        "brand": {
          "type": "string",
          "minLength": 1
        },
        "model_name": {
          "type": "string",
          "minLength": 1
        },
        "normalized_model_key": {
          "type": "string",
          "minLength": 1
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "namespace",
              "value"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "issuer": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "description": {
          "type": "string"
        },
        "taxonomy_version": {
          "type": "string"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "ProductVariant": {
      "type": "object",
      "required": [
        "record_type",
        "id",
        "schema_version",
        "created_at",
        "updated_at",
        "status",
        "model_id",
        "variant_key",
        "attributes"
      ],
      "properties": {
        "record_type": {
          "const": "product_variant"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "suppressed",
            "archived"
          ]
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_key": {
          "type": "string",
          "minLength": 1
        },
        "attributes": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "integer",
              "boolean",
              "null"
            ]
          }
        },
        "region": {
          "type": [
            "string",
            "null"
          ]
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "namespace",
              "value"
            ],
            "properties": {
              "namespace": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string",
                "minLength": 1
              },
              "issuer": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    },
    "Source": {
      "type": "object",
      "required": [
        "record_type",
        "id",
        "schema_version",
        "created_at",
        "updated_at",
        "status",
        "publisher",
        "source_type",
        "url",
        "accessed_at",
        "terms_status"
      ],
      "properties": {
        "record_type": {
          "const": "source"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "suppressed",
            "archived"
          ]
        },
        "publisher": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "type": "string",
          "enum": [
            "manufacturer",
            "merchant",
            "independent_review",
            "approved_dataset",
            "official_regulator",
            "other"
          ]
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "accessed_at": {
          "type": "string",
          "format": "date-time"
        },
        "published_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "terms_status": {
          "type": "string",
          "enum": [
            "approved",
            "pending_review",
            "prohibited",
            "unknown"
          ]
        },
        "locale": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Evidence": {
      "type": "object",
      "required": [
        "record_type",
        "id",
        "schema_version",
        "created_at",
        "updated_at",
        "status",
        "subject_type",
        "subject_id",
        "claim_key",
        "source_id",
        "observed_at",
        "verification_status"
      ],
      "properties": {
        "record_type": {
          "const": "evidence"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "suppressed",
            "archived"
          ]
        },
        "subject_type": {
          "type": "string",
          "enum": [
            "product_model",
            "product_variant",
            "merchant",
            "offer"
          ]
        },
        "subject_id": {
          "type": "string",
          "minLength": 1
        },
        "claim_key": {
          "type": "string",
          "minLength": 1
        },
        "raw_value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "normalized_value": {
          "type": [
            "string",
            "number",
            "integer",
            "boolean",
            "null"
          ]
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "verification_status": {
          "type": "string",
          "enum": [
            "unverified",
            "verified",
            "disputed",
            "rejected",
            "stale"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewed_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "Merchant": {
      "type": "object",
      "required": [
        "record_type",
        "id",
        "schema_version",
        "created_at",
        "updated_at",
        "status",
        "name",
        "country"
      ],
      "properties": {
        "record_type": {
          "const": "merchant"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "suppressed",
            "archived"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "country": {
          "type": "string",
          "pattern": "^[A-Z]{2}$"
        },
        "official_domain": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "Offer": {
      "type": "object",
      "required": [
        "record_type",
        "id",
        "schema_version",
        "created_at",
        "updated_at",
        "status",
        "model_id",
        "merchant_id",
        "currency",
        "availability",
        "source_id",
        "checked_at"
      ],
      "properties": {
        "record_type": {
          "const": "offer"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "suppressed",
            "archived"
          ]
        },
        "model_id": {
          "type": "string",
          "minLength": 1
        },
        "variant_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "merchant_id": {
          "type": "string",
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "price_amount": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "availability": {
          "type": "string",
          "enum": [
            "in_stock",
            "out_of_stock",
            "preorder",
            "unknown"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "checked_at": {
          "type": "string",
          "format": "date-time"
        },
        "merchant_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "affiliate_link_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "PriceObservation": {
      "type": "object",
      "required": [
        "record_type",
        "id",
        "schema_version",
        "created_at",
        "updated_at",
        "status",
        "offer_id",
        "amount",
        "currency",
        "observed_at",
        "source_id"
      ],
      "properties": {
        "record_type": {
          "const": "price_observation"
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema_version": {
          "type": "string",
          "const": "1.0"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": [
            "draft",
            "active",
            "suppressed",
            "archived"
          ]
        },
        "offer_id": {
          "type": "string",
          "minLength": 1
        },
        "amount": {
          "type": "number",
          "minimum": 0
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "price_kind": {
          "type": "string",
          "enum": [
            "current",
            "list",
            "sale",
            "member",
            "other"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
